<script>
  const telas = document.querySelectorAll('.tela');
  const botoes = document.querySelectorAll('.mini');

  function mostrar(id){
    telas.forEach(t => t.classList.toggle('ativa', t.dataset.tela === id));
    botoes.forEach(b => b.classList.toggle('on', b.dataset.ir === id));
    const ativa = document.querySelector('.tela.ativa .body');
    if (ativa) ativa.scrollTop = 0;
  }

  document.addEventListener('click', e => {
    const alvo = e.target.closest('[data-ir]');
    if (!alvo) return;
    e.preventDefault();
    mostrar(alvo.dataset.ir);
  });

  mostrar('home');
</script>

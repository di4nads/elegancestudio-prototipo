<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EleganceStudio — protótipo navegável</title>
<style>
  :root{
    --canvas:#E4E4E4;
    --frame:#FFFFFF;
    --line:#C7C7C7;
    --line-soft:#DEDEDE;
    --fill:#EFEFEF;
    --ink:#2E2E2E;
    --ink-soft:#6E6E6E;
    --dark:#3A3A3A;
  }

  *{box-sizing:border-box;}

  body{
    margin:0;
    background:var(--canvas);
    font-family:"Inter","Helvetica Neue",Arial,sans-serif;
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
    scroll-behavior:smooth;
  }

  .page-head{
    padding:40px 40px 8px;
    max-width:1600px;
    margin:0 auto;
  }
  .page-head h1{
    font-size:22px;
    font-weight:600;
    margin:0 0 6px;
    letter-spacing:-0.01em;
  }
  .page-head p{
    margin:0;
    font-size:13px;
    color:var(--ink-soft);
    max-width:70ch;
    line-height:1.5;
  }

  .board{
    display:flex;
    flex-wrap:wrap;
    gap:56px 40px;
    padding:32px 40px 80px;
    max-width:1600px;
    margin:0 auto;
    align-items:flex-start;
  }

  .frame-wrap{width:360px;}

  .frame-label{
    font-size:12px;
    font-weight:600;
    color:var(--ink-soft);
    margin-bottom:8px;
    letter-spacing:0.01em;
  }

  .frame{
    width:360px;
    height:800px;
    background:var(--frame);
    border:1px solid var(--line);
    overflow:hidden;
    display:flex;
    flex-direction:column;
  }

  .statusbar{
    height:24px;
    flex:0 0 24px;
    background:var(--fill);
    border-bottom:1px solid var(--line-soft);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 12px;
    font-size:10px;
    color:var(--ink-soft);
  }

  .appbar{
    flex:0 0 52px;
    border-bottom:1px solid var(--line-soft);
    display:flex;
    align-items:center;
    gap:10px;
    padding:0 16px;
    font-size:14px;
    font-weight:600;
  }
  .appbar .back{
    color:var(--ink-soft);
    text-decoration:none;
    font-size:16px;
    line-height:1;
  }

  .body{
    flex:1 1 auto;
    padding:16px;
    overflow:hidden;
  }

  .stack{display:flex;flex-direction:column;gap:12px;}
  .stack-sm{display:flex;flex-direction:column;gap:8px;}

  .h1{font-size:20px;font-weight:600;margin:0;letter-spacing:-0.01em;}
  .h2{font-size:15px;font-weight:600;margin:0;}
  .p{font-size:12.5px;line-height:1.5;margin:0;color:var(--ink-soft);}
  .label{font-size:11px;color:var(--ink-soft);margin-bottom:4px;display:block;}
  .muted{color:var(--ink-soft);font-size:11.5px;}

  .placeholder{
    background:var(--fill);
    border:1px solid var(--line-soft);
    display:flex;
    align-items:center;
    justify-content:center;
    color:#A5A5A5;
    font-size:11px;
  }
  .hero-img{height:150px;}
  .thumb{width:52px;height:52px;flex:0 0 52px;}

  .field{
    height:40px;
    border:1px solid var(--line);
    background:#FBFBFB;
    display:flex;
    align-items:center;
    padding:0 12px;
    font-size:12.5px;
    color:#9A9A9A;
  }

  .btn{
    height:44px;
    background:var(--dark);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:13.5px;
    font-weight:500;
    text-decoration:none;
    border:1px solid var(--dark);
  }
  .btn-ghost{
    height:44px;
    background:transparent;
    color:var(--ink);
    border:1px solid var(--line);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:13.5px;
    text-decoration:none;
  }
  .btn-sm{
    height:32px;
    padding:0 14px;
    background:var(--dark);
    color:#fff;
    font-size:12px;
    display:inline-flex;
    align-items:center;
    text-decoration:none;
    border:1px solid var(--dark);
  }
  .btn-sm-ghost{
    height:32px;
    padding:0 14px;
    background:transparent;
    color:var(--ink);
    font-size:12px;
    display:inline-flex;
    align-items:center;
    text-decoration:none;
    border:1px solid var(--line);
  }
  .link{
    font-size:12px;
    color:var(--ink);
    text-decoration:underline;
    text-align:center;
  }

  .card{
    border:1px solid var(--line-soft);
    padding:12px;
    display:flex;
    gap:12px;
    align-items:center;
  }
  .card .grow{flex:1 1 auto;min-width:0;}
  .card-title{font-size:13.5px;font-weight:600;margin:0 0 2px;}

  .divider{height:1px;background:var(--line-soft);}

  .row{display:flex;gap:8px;align-items:center;}
  .row-between{display:flex;justify-content:space-between;align-items:center;}

  .chips{display:flex;flex-wrap:wrap;gap:8px;}
  .chip{
    border:1px solid var(--line);
    padding:7px 12px;
    font-size:12px;
    color:var(--ink);
    text-decoration:none;
  }
  .chip-on{background:var(--dark);color:#fff;border-color:var(--dark);}
  .chip-off{color:#B5B5B5;background:#F7F7F7;text-decoration:line-through;}

  .cal{
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:4px;
  }
  .cal div{
    height:34px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:11.5px;
    border:1px solid var(--line-soft);
  }
  .cal .dow{border:0;color:var(--ink-soft);font-size:10px;height:20px;}
  .cal .off{color:#C4C4C4;background:#F7F7F7;}
  .cal .sel{background:var(--dark);color:#fff;border-color:var(--dark);}

  .tabs{display:flex;border-bottom:1px solid var(--line-soft);}
  .tabs span{
    flex:1;
    text-align:center;
    padding:10px 0;
    font-size:12.5px;
    color:var(--ink-soft);
  }
  .tabs .on{color:var(--ink);font-weight:600;border-bottom:2px solid var(--dark);}

  .status-tag{
    font-size:10.5px;
    border:1px solid var(--line);
    padding:2px 7px;
    color:var(--ink-soft);
    white-space:nowrap;
  }

  .summary{border:1px solid var(--line-soft);padding:14px;}
  .summary .line{
    display:flex;
    justify-content:space-between;
    font-size:12.5px;
    padding:7px 0;
    gap:12px;
  }
  .summary .line + .line{border-top:1px solid var(--line-soft);}
  .summary .line span:first-child{color:var(--ink-soft);}

  .slot{
    display:flex;
    gap:10px;
    padding:10px 0;
    border-bottom:1px solid var(--line-soft);
    font-size:12px;
  }
  .slot .hour{width:44px;flex:0 0 44px;color:var(--ink-soft);}
  .slot .grow{flex:1 1 auto;}
  .slot .name{font-weight:600;font-size:12.5px;}

  .tabbar{
    flex:0 0 56px;
    border-top:1px solid var(--line-soft);
    display:flex;
  }
  .tabbar span{
    flex:1;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:10.5px;
    color:var(--ink-soft);
  }
  .tabbar .on{color:var(--ink);font-weight:600;}

  .kpis{display:flex;gap:8px;}
  .kpi{
    flex:1;
    border:1px solid var(--line-soft);
    padding:10px;
    text-align:center;
  }
  .kpi b{display:block;font-size:18px;font-weight:600;}
  .kpi span{font-size:10.5px;color:var(--ink-soft);}

  a{color:inherit;}

  html,body{height:100%;}
  body{
    background:#DFDFDF;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    min-height:100vh;
    padding:24px 16px 32px;
    gap:18px;
  }
  .topo{text-align:center;}
  .topo h1{font-size:16px;font-weight:600;margin:0 0 4px;}
  .topo p{font-size:12px;color:var(--ink-soft);margin:0;}

  .device{
    width:392px;
    padding:16px;
    background:#2B2B2B;
    border-radius:34px;
    box-shadow:0 18px 40px rgba(0,0,0,.28);
    flex:0 0 auto;
  }
  .device .frame{
    width:360px;
    height:760px;
    border:0;
    border-radius:20px;
    overflow:hidden;
    position:relative;
  }
  .tela{display:none;flex-direction:column;height:100%;}
  .tela.ativa{display:flex;}
  .tela .body{overflow-y:auto;}

  .indice{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    justify-content:center;
    max-width:460px;
  }
  .mini{
    font:inherit;
    font-size:11px;
    padding:6px 10px;
    background:#fff;
    border:1px solid var(--line);
    color:var(--ink-soft);
    cursor:pointer;
    border-radius:2px;
  }
  .mini:hover{color:var(--ink);border-color:#9A9A9A;}
  .mini.on{background:var(--dark);border-color:var(--dark);color:#fff;}
  .dica{font-size:11.5px;color:var(--ink-soft);text-align:center;max-width:420px;line-height:1.5;}
  a{cursor:pointer;}
  a:focus-visible,.mini:focus-visible{outline:2px solid #2B2B2B;outline-offset:2px;}
</style>
</head>
